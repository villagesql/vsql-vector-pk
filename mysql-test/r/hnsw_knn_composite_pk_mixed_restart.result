SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_vector;
CREATE TABLE docs (
k_vc  VARCHAR(75) CHARACTER SET utf8mb4 NOT NULL,
k_ti  TINYINT                           NOT NULL,
k_cu  CHAR(8) CHARACTER SET utf8mb4      NOT NULL,
k_bi  BIGINT                            NOT NULL,
k_vb  VARBINARY(70)                     NOT NULL,
k_cl  CHAR(10) CHARACTER SET latin1      NOT NULL,
k_bin BINARY(16)                        NOT NULL,
vec   SVECTOR(4)                        NOT NULL,
tag   VARCHAR(16),
PRIMARY KEY (k_vc, k_ti, k_cu, k_bi, k_vb, k_cl, k_bin),
INDEX idx_vec (vec hnsw_l2) USING EXTENDED(hnsw)
) ENGINE=InnoDB;
# Four rows with distinct composite keys and distinct vectors. The key
# columns carry deliberately awkward bytes:
#   - embedded NUL bytes in VARBINARY (a C-string reader would truncate)
#   - VARBINARY bytes that look like a 4-byte length prefix (0x00000004...)
#   - a VARCHAR whose bytes equal another row's, disambiguated only by
#     later parts (so a dropped/reordered part collapses rows)
#   - CHAR with a trailing space and an all-NUL BINARY(16)
#   - integer extremes (min/max TINYINT and BIGINT, and 0)
INSERT INTO docs VALUES
(REPEAT('e', 75), -128, REPEAT(_utf8mb4 'x', 8), -9223372036854775808,
0x0000000441424344, 'alpha', 0x00112233445566778899AABBCCDDEEFF,
'[1.0, 2.0, 3.0, 4.0]', 'one');
INSERT INTO docs VALUES
(REPEAT(_utf8mb4 '€', 25), 127, 'short', 9223372036854775807,
0x41004200430044, 'beta ', 0x00000000000000000000000000000000,
'[5.0, 6.0, 7.0, 8.0]', 'two');
INSERT INTO docs VALUES
('', 0, REPEAT(_utf8mb4 'y', 8), 0,
0x00, 'gamma', 0x0102030405060708090A0B0C0D0E0F10,
'[9.0, 1.0, 2.0, 3.0]', 'three');
# Same k_vc, k_ti and k_bi as row 'two', diverging only at k_cu and
# beyond: proves the whole key (not a prefix) is stored and returned.
INSERT INTO docs VALUES
(REPEAT(_utf8mb4 '€', 25), 127, 'other', 9223372036854775807,
0xFF, 'delta', 0x0F0E0D0C0B0A09080706050403020100,
'[4.0, 3.0, 2.0, 1.0]', 'four');
# --- Restart server after insert: the index storage, including the PK
# --- store holding the packed composite keys, is reloaded from disk; the
# --- KNN resolution below then reads the recovered keys, not in-memory
# --- state. Verifies the on-disk spilled keys survive a restart.
# restart
# All four rows are stored and read back by their composite key.
SELECT k_ti, k_bi, k_cl, tag FROM docs FORCE INDEX (PRIMARY)
ORDER BY tag;
k_ti	k_bi	k_cl	tag
127	9223372036854775807	delta	four
-128	-9223372036854775808	alpha	one
0	0	gamma	three
127	9223372036854775807	beta	two
# The KNN queries below are served BY the HNSW index (a custom index
# distance scan, no filesort) -- otherwise a full scan + sort would return
# correct rows without ever exercising the packed row-reference path.
# FORMAT=TREE because the hypergraph optimizer rejects TRADITIONAL EXPLAIN;
# cost/rows are masked as they vary with data.
EXPLAIN FORMAT=TREE
SELECT tag FROM docs ORDER BY L2_DISTANCE(vec, '[5.0, 6.0, 7.0, 8.0]') LIMIT 1;
EXPLAIN
-> Limit: 1 row(s)  (cost=# rows=#)
    -> Custom index distance scan on idx_vec  (cost=# rows=#)

# KNN whose query vector is exactly row 'two' ([5,6,7,8]) resolves to that
# row: the whole composite key round-trips through the packed reference.
SELECT tag FROM docs
ORDER BY L2_DISTANCE(vec, '[5.0, 6.0, 7.0, 8.0]') LIMIT 1;
tag
two
# KNN whose query vector is exactly row 'one' resolves to 'one'.
SELECT tag FROM docs
ORDER BY L2_DISTANCE(vec, '[1.0, 2.0, 3.0, 4.0]') LIMIT 1;
tag
one
# KNN returning all four, each resolved to its correct row: 'two' and
# 'four' share k_vc, k_ti and k_bi and diverge only at k_cu, so a
# prefix-only key would collapse them.
SELECT tag FROM docs
ORDER BY L2_DISTANCE(vec, '[1.0, 2.0, 3.0, 4.0]') LIMIT 4;
tag
four
one
three
two
DROP TABLE docs;
UNINSTALL EXTENSION vsql_vector;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
