SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_vector;
CREATE TABLE docs (
id      INT PRIMARY KEY,
vec     SVECTOR(4) NOT NULL,
payload VARCHAR(32),
INDEX idx_vec (vec hnsw_l2) USING EXTENDED(hnsw)
) ENGINE=InnoDB;
# INSERT is supported: rows go in and the index is maintained.
INSERT INTO docs VALUES (1, '[1.0, 2.0, 3.0, 4.0]', 'one');
INSERT INTO docs VALUES (2, '[5.0, 6.0, 7.0, 8.0]', 'two');
INSERT INTO docs VALUES (3, '[9.0, 1.0, 2.0, 3.0]', 'three');
SELECT id, payload FROM docs FORCE INDEX (PRIMARY) ORDER BY id;
id	payload
1	one
2	two
3	three
# ===================================================================
# 1. DELETE of an indexed row is not supported
# ===================================================================
DELETE FROM docs WHERE id = 2;
ERROR HY000: DELETE on a table with a custom index (USING EXTENDED) is not supported yet.
# The row is unchanged.
SELECT id, payload FROM docs FORCE INDEX (PRIMARY) ORDER BY id;
id	payload
1	one
2	two
3	three
# ===================================================================
# 2. UPDATE of the indexed vector column is not supported
# ===================================================================
UPDATE docs SET vec = '[0.0, 0.0, 0.0, 0.0]' WHERE id = 1;
ERROR HY000: UPDATE that changes an indexed column on a table with a custom index (USING EXTENDED) is not supported yet.
# The vector is unchanged (still nearest to its own value).
SELECT id FROM docs ORDER BY L2_DISTANCE(vec, '[1.0, 2.0, 3.0, 4.0]') LIMIT 1;
id
1
# ===================================================================
# 3. UPDATE that changes the primary key is not supported
# ===================================================================
UPDATE docs SET id = 10 WHERE id = 1;
ERROR HY000: UPDATE that changes an indexed column on a table with a custom index (USING EXTENDED) is not supported yet.
# The primary key is unchanged.
SELECT id, payload FROM docs FORCE INDEX (PRIMARY) ORDER BY id;
id	payload
1	one
2	two
3	three
# ===================================================================
# 4. UPDATE of a non-indexed (payload) column is supported
# ===================================================================
# It changes no index ordering field, so the custom index is not touched.
UPDATE docs SET payload = 'ONE' WHERE id = 1;
SELECT id, payload FROM docs FORCE INDEX (PRIMARY) ORDER BY id;
id	payload
1	ONE
2	two
3	three
# ===================================================================
# 5. Upserts that resolve to a delete/update are rejected (not a crash)
# ===================================================================
# REPLACE on a key conflict resolves to an update of the existing row,
# so it hits the unsupported update path. (id = 1 already exists.)
REPLACE INTO docs VALUES (1, '[1.0, 1.0, 1.0, 1.0]', 'replaced');
ERROR HY000: UPDATE that changes an indexed column on a table with a custom index (USING EXTENDED) is not supported yet.
# INSERT ... ON DUPLICATE KEY UPDATE that changes the vector hits the
# unsupported update path on the conflicting row.
INSERT INTO docs VALUES (1, '[2.0, 2.0, 2.0, 2.0]', 'dup')
ON DUPLICATE KEY UPDATE vec = '[2.0, 2.0, 2.0, 2.0]';
ERROR HY000: UPDATE that changes an indexed column on a table with a custom index (USING EXTENDED) is not supported yet.
# The row is unchanged by either rejected upsert.
SELECT id, payload FROM docs FORCE INDEX (PRIMARY) ORDER BY id;
id	payload
1	ONE
2	two
3	three
# A REPLACE that inserts a brand-new row (no conflict) is a plain INSERT
# and is supported.
REPLACE INTO docs VALUES (4, '[4.0, 4.0, 4.0, 4.0]', 'four');
SELECT id, payload FROM docs FORCE INDEX (PRIMARY) ORDER BY id;
id	payload
1	ONE
2	two
3	three
4	four
# HNSW DML test completed
DROP TABLE docs;
UNINSTALL EXTENSION vsql_vector;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
