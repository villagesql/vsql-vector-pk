SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_vector;
SET @saved_cache_mode = @@GLOBAL.vsql_vector.cache_mode;
SET GLOBAL vsql_vector.cache_mode = 1;
CREATE TABLE tc (
id INT PRIMARY KEY,
v  SVECTOR(4) NOT NULL,
INDEX idx_v (v hnsw_cosine) USING EXTENDED(hnsw) WITH (M = 8, ef_construction = 64)
) ENGINE=InnoDB;
CREATE TABLE ti (
id INT PRIMARY KEY,
v  SVECTOR(4) NOT NULL,
INDEX idx_v (v hnsw_inner_product) USING EXTENDED(hnsw) WITH (M = 8, ef_construction = 64)
) ENGINE=InnoDB;
#
# 1. Cosine.
#
EXPLAIN FORMAT=TREE SELECT id FROM tc ORDER BY COSINE_DISTANCE(v, '[1, 0.5, -0.3, 0.2]') LIMIT 10;
EXPLAIN
-> Limit: 10 row(s)  (cost=20.2 rows=10)
    -> Custom index distance scan on idx_v  (cost=20.2 rows=200)

SELECT VARIABLE_VALUE INTO @hits0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'vsql_vector.cache_hits';
# Through the index:
SELECT id, ROUND(COSINE_DISTANCE(v, '[1, 0.5, -0.3, 0.2]'), 4) AS d FROM tc ORDER BY COSINE_DISTANCE(v, '[1, 0.5, -0.3, 0.2]') LIMIT 10;
id	d
166	0.0125
33	0.0228
96	0.028
178	0.0383
82	0.0397
103	0.0402
52	0.0547
159	0.0579
115	0.0747
34	0.0789
SELECT VARIABLE_VALUE INTO @hits1 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'vsql_vector.cache_hits';
SELECT @hits1 - @hits0 > 0 AS served_from_cache;
served_from_cache
1
# Brute force (primary key scan and sort):
SELECT id, ROUND(COSINE_DISTANCE(v, '[1, 0.5, -0.3, 0.2]'), 4) AS d FROM tc FORCE INDEX (PRIMARY) ORDER BY COSINE_DISTANCE(v, '[1, 0.5, -0.3, 0.2]') LIMIT 10;
id	d
166	0.0125
33	0.0228
96	0.028
178	0.0383
82	0.0397
103	0.0402
52	0.0547
159	0.0579
115	0.0747
34	0.0789
#
# 2. Inner product.
#
EXPLAIN FORMAT=TREE SELECT id FROM ti ORDER BY NEGATIVE_INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]') LIMIT 10;
EXPLAIN
-> Limit: 10 row(s)  (cost=20.2 rows=10)
    -> Custom index distance scan on idx_v  (cost=20.2 rows=200)

SELECT VARIABLE_VALUE INTO @hits0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'vsql_vector.cache_hits';
# Through the index:
SELECT id, ROUND(INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]'), 4) AS ip FROM ti ORDER BY NEGATIVE_INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]') LIMIT 10;
id	ip
159	8.3399
33	8.1141
96	7.1649
89	6.2742
20	6.1313
27	6.0424
146	5.9507
90	5.8636
59	5.6381
152	5.6303
SELECT VARIABLE_VALUE INTO @hits1 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'vsql_vector.cache_hits';
SELECT @hits1 - @hits0 > 0 AS served_from_cache;
served_from_cache
1
# Brute force (primary key scan and sort):
SELECT id, ROUND(INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]'), 4) AS ip FROM ti FORCE INDEX (PRIMARY) ORDER BY NEGATIVE_INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]') LIMIT 10;
id	ip
159	8.3399
33	8.1141
96	7.1649
89	6.2742
20	6.1313
27	6.0424
146	5.9507
90	5.8636
59	5.6381
152	5.6303
DROP TABLE tc, ti;
SET GLOBAL vsql_vector.cache_mode = @saved_cache_mode;
UNINSTALL EXTENSION vsql_vector;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
