SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_vector;
CREATE TABLE t (
id INT PRIMARY KEY,
v SVECTOR(4) NOT NULL,
INDEX idx_v (v hnsw_cosine) USING EXTENDED(hnsw) WITH (M = 8, ef_construction = 64)
) ENGINE=InnoDB;
INSERT INTO t VALUES (1, '[1,0,0,0]');
INSERT INTO t VALUES (2, '[1,1,0,0]');
INSERT INTO t VALUES (3, '[0,1,0,0]');
INSERT INTO t VALUES (4, '[-1,1,0,0]');
INSERT INTO t VALUES (5, '[-1,0,0,0]');
# --- Plan: a custom index distance scan on idx_v, no Sort/filesort ---
EXPLAIN FORMAT=TREE
SELECT id FROM t ORDER BY COSINE_DISTANCE(v, '[1,0,0,0]') LIMIT 10;
EXPLAIN
-> Limit: 10 row(s)  (cost=0.75 rows=5)
    -> Custom index distance scan on idx_v  (cost=0.75 rows=5)

# --- Result: nearest-first by angle -> 1, 2, 3, 4, 5 ---
SELECT id FROM t ORDER BY COSINE_DISTANCE(v, '[1,0,0,0]') LIMIT 10;
id
1
2
3
4
5
# --- LIMIT smaller than the row set: the 3 most-similar -> 1, 2, 3 ---
SELECT id FROM t ORDER BY COSINE_DISTANCE(v, '[1,0,0,0]') LIMIT 3;
id
1
2
3
# --- Filter above the scan: id > 2 leaves {3,4,5}; nearest-first 3, 4, 5.
# --- (5 - 3, not a bare literal, keeps this a filter above the scan.) ---
SELECT id FROM t WHERE id > 5 - 3 ORDER BY COSINE_DISTANCE(v, '[1,0,0,0]') LIMIT 10;
id
3
4
5
DROP TABLE t;
UNINSTALL EXTENSION vsql_vector;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
