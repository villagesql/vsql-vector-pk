SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_vector;
CREATE TABLE t (
id INT PRIMARY KEY,
v  SVECTOR(4) NOT NULL,
INDEX idx_v (v hnsw_inner_product) USING EXTENDED(hnsw) WITH (M = 8, ef_construction = 64)
) ENGINE=InnoDB;
#
# 1. INNER_PRODUCT is not served by the index, in either direction.
#
EXPLAIN FORMAT=TREE SELECT id FROM t ORDER BY INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]') DESC LIMIT 10;
EXPLAIN
-> Limit: 10 row(s)
    -> Sort: vsql_vector.inner_product(t.v,'[1,0.5,-0.300000012,0.200000003]') DESC, limit input to 10 row(s) per chunk
        -> Stream results  (cost=20.2 rows=200)
            -> Table scan on t  (cost=20.2 rows=200)

EXPLAIN FORMAT=TREE SELECT id FROM t ORDER BY INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]') LIMIT 10;
EXPLAIN
-> Limit: 10 row(s)
    -> Sort: vsql_vector.inner_product(t.v,'[1,0.5,-0.300000012,0.200000003]'), limit input to 10 row(s) per chunk
        -> Stream results  (cost=20.2 rows=200)
            -> Table scan on t  (cost=20.2 rows=200)

#
# 2. NEGATIVE_INNER_PRODUCT is the negated dot product.
#
SELECT COUNT(*) AS mismatches FROM t WHERE NEGATIVE_INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]') <> -INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]');
mismatches
0
#
# 3. NEGATIVE_INNER_PRODUCT ascending is served by the index, most similar
#    first. It must match brute force, and the most-similar-first
#    INNER_PRODUCT DESC list.
#
EXPLAIN FORMAT=TREE SELECT id FROM t ORDER BY NEGATIVE_INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]') LIMIT 10;
EXPLAIN
-> Limit: 10 row(s)  (cost=20.2 rows=10)
    -> Custom index distance scan on idx_v  (cost=20.2 rows=200)

# Through the index:
SELECT id, ROUND(INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]'), 4) AS ip FROM t ORDER BY NEGATIVE_INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]') LIMIT 10;
id	ip
159	8.3399
33	8.1141
96	7.1649
89	6.2742
20	6.1313
27	6.0424
146	5.9507
90	5.8636
59	5.6381
152	5.6303
# Brute force (primary key scan and sort):
SELECT id, ROUND(INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]'), 4) AS ip FROM t FORCE INDEX (PRIMARY) ORDER BY NEGATIVE_INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]') LIMIT 10;
id	ip
159	8.3399
33	8.1141
96	7.1649
89	6.2742
20	6.1313
27	6.0424
146	5.9507
90	5.8636
59	5.6381
152	5.6303
# INNER_PRODUCT DESC (brute force):
SELECT id, ROUND(INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]'), 4) AS ip FROM t ORDER BY INNER_PRODUCT(v, '[1, 0.5, -0.3, 0.2]') DESC LIMIT 10;
id	ip
159	8.3399
33	8.1141
96	7.1649
89	6.2742
20	6.1313
27	6.0424
146	5.9507
90	5.8636
59	5.6381
152	5.6303
DROP TABLE t;
UNINSTALL EXTENSION vsql_vector;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
