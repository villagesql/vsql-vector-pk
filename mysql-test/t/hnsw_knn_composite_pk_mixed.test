# KNN over an HNSW (USING EXTENDED) index on a table whose COMPOSITE primary key
# mixes fixed- and variable-length column types, with a variable-length column
# FIRST and fixed/variable columns interleaved. The index owns row resolution: a
# composite key is packed into the extension's PK store at insert and unpacked to
# the full key at scan. Each part is framed [len][bytes] and sized to the column's
# InnoDB max length, so the unpack walk must resume one part immediately after the
# previous regardless of their types -- a path an "all variable fields at the end"
# layout would never exercise.
#
# Note the subtlety this exercises: whether a column is fixed- or variable-length
# in InnoDB is NOT the SQL type name. CHAR(n) latin1 is fixed; CHAR(n) utf8mb4 is
# variable (COMPACT stores multibyte CHAR variable-length). The per-part max the
# packer reserves comes from the InnoDB descriptor, not the type name -- both
# kinds appear in this key.

SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_vector;

# Composite PK, variable-length column first, fixed/variable interleaved, with a
# range of InnoDB max-lengths per part (VARCHAR(75) utf8mb4, TINYINT, CHAR(8)
# utf8mb4, BIGINT, VARBINARY(70), CHAR(10) latin1, BINARY(16)).
CREATE TABLE docs (
  k_vc  VARCHAR(75) CHARACTER SET utf8mb4 NOT NULL,
  k_ti  TINYINT                           NOT NULL,
  k_cu  CHAR(8) CHARACTER SET utf8mb4      NOT NULL,
  k_bi  BIGINT                            NOT NULL,
  k_vb  VARBINARY(70)                     NOT NULL,
  k_cl  CHAR(10) CHARACTER SET latin1      NOT NULL,
  k_bin BINARY(16)                        NOT NULL,
  vec   SVECTOR(4)                        NOT NULL,
  tag   VARCHAR(16),
  PRIMARY KEY (k_vc, k_ti, k_cu, k_bi, k_vb, k_cl, k_bin),
  INDEX idx_vec (vec hnsw_l2) USING EXTENDED(hnsw)
) ENGINE=InnoDB;

--echo # Four rows with distinct composite keys and distinct vectors. The key
--echo # columns carry deliberately awkward bytes:
--echo #   - embedded NUL bytes in VARBINARY (a C-string reader would truncate)
--echo #   - VARBINARY bytes that look like a 4-byte length prefix (0x00000004...)
--echo #   - a VARCHAR whose bytes equal another row's, disambiguated only by
--echo #     later parts (so a dropped/reordered part collapses rows)
--echo #   - CHAR with a trailing space and an all-NUL BINARY(16)
--echo #   - integer extremes (min/max TINYINT and BIGINT, and 0)
INSERT INTO docs VALUES
  (REPEAT('e', 75), -128, REPEAT(_utf8mb4 'x', 8), -9223372036854775808,
   0x0000000441424344, 'alpha', 0x00112233445566778899AABBCCDDEEFF,
   '[1.0, 2.0, 3.0, 4.0]', 'one');
INSERT INTO docs VALUES
  (REPEAT(_utf8mb4 '€', 25), 127, 'short', 9223372036854775807,
   0x41004200430044, 'beta ', 0x00000000000000000000000000000000,
   '[5.0, 6.0, 7.0, 8.0]', 'two');
INSERT INTO docs VALUES
  ('', 0, REPEAT(_utf8mb4 'y', 8), 0,
   0x00, 'gamma', 0x0102030405060708090A0B0C0D0E0F10,
   '[9.0, 1.0, 2.0, 3.0]', 'three');
--echo # Same k_vc, k_ti and k_bi as row 'two', diverging only at k_cu and
--echo # beyond: proves the whole key (not a prefix) is stored and returned.
INSERT INTO docs VALUES
  (REPEAT(_utf8mb4 '€', 25), 127, 'other', 9223372036854775807,
   0xFF, 'delta', 0x0F0E0D0C0B0A09080706050403020100,
   '[4.0, 3.0, 2.0, 1.0]', 'four');

if ($restart) {
--echo # --- Restart server after insert: the index storage, including the PK
--echo # --- store holding the packed composite keys, is reloaded from disk; the
--echo # --- KNN resolution below then reads the recovered keys, not in-memory
--echo # --- state. Verifies the on-disk spilled keys survive a restart.
--source include/restart_mysqld.inc
}

--echo # All four rows are stored and read back by their composite key.
SELECT k_ti, k_bi, k_cl, tag FROM docs FORCE INDEX (PRIMARY)
  ORDER BY tag;

--echo # The KNN queries below are served BY the HNSW index (a custom index
--echo # distance scan, no filesort) -- otherwise a full scan + sort would return
--echo # correct rows without ever exercising the packed row-reference path.
--echo # FORMAT=TREE because the hypergraph optimizer rejects TRADITIONAL EXPLAIN;
--echo # cost/rows are masked as they vary with data.
--replace_regex /\(cost=[0-9.e+-]+ rows=[0-9.e+-]+\)/(cost=# rows=#)/
EXPLAIN FORMAT=TREE
  SELECT tag FROM docs ORDER BY L2_DISTANCE(vec, '[5.0, 6.0, 7.0, 8.0]') LIMIT 1;

--echo # KNN whose query vector is exactly row 'two' ([5,6,7,8]) resolves to that
--echo # row: the whole composite key round-trips through the packed reference.
SELECT tag FROM docs
  ORDER BY L2_DISTANCE(vec, '[5.0, 6.0, 7.0, 8.0]') LIMIT 1;

--echo # KNN whose query vector is exactly row 'one' resolves to 'one'.
SELECT tag FROM docs
  ORDER BY L2_DISTANCE(vec, '[1.0, 2.0, 3.0, 4.0]') LIMIT 1;

--echo # KNN returning all four, each resolved to its correct row: 'two' and
--echo # 'four' share k_vc, k_ti and k_bi and diverge only at k_cu, so a
--echo # prefix-only key would collapse them.
--sorted_result
SELECT tag FROM docs
  ORDER BY L2_DISTANCE(vec, '[1.0, 2.0, 3.0, 4.0]') LIMIT 4;

DROP TABLE docs;

UNINSTALL EXTENSION vsql_vector;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
