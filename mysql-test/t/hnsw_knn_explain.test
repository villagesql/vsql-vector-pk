# KNN query routing for the HNSW SVECTOR index: an
# ORDER BY <distance>(v, <literal>) LIMIT k query is served by the custom index
# distance scan (not a full table scan + filesort), and returns rows in
# ascending-distance (nearest-first) order.
#
# Verified on two axes:
#   1. Plan shape (EXPLAIN FORMAT=TREE): a custom index distance scan on the
#      HNSW index, with no Sort/filesort. A filesort fallback would mean the KNN
#      routing did not engage. FORMAT=TREE is used because the hypergraph
#      optimizer rejects the default TRADITIONAL EXPLAIN format.
#   2. Result correctness: the nearest-first order the plan produces.
#
# villagesql_custom_index_proceed bypasses the "not yet implemented" DDL guard
# (see hnsw_create.test); requires a debug build.

SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_vector;

CREATE TABLE t (
  id INT PRIMARY KEY,
  v SVECTOR(4) NOT NULL,
  INDEX idx_v (v hnsw_l2) USING EXTENDED(hnsw) WITH (M = 8, ef_construction = 64)
) ENGINE=InnoDB;

# Distinct L2 distances from the query [1,2,3,4] so ORDER BY is unambiguous:
#   id 1 [1,2,3,4] -> 0    (exact)
#   id 5 [2,2,3,4] -> 1
#   id 3 [1,2,3,6] -> 4
#   id 2 [4,3,2,1] -> 20
#   id 4 [9,9,9,9] -> large
INSERT INTO t VALUES (1, '[1,2,3,4]');
INSERT INTO t VALUES (2, '[4,3,2,1]');
INSERT INTO t VALUES (3, '[1,2,3,6]');
INSERT INTO t VALUES (4, '[9,9,9,9]');
INSERT INTO t VALUES (5, '[2,2,3,4]');

--echo # --- Plan: a custom index distance scan on idx_v, no Sort/filesort ---
EXPLAIN FORMAT=TREE
  SELECT id FROM t ORDER BY L2_DISTANCE(v, '[1,2,3,4]') LIMIT 10;

--echo # --- Result: nearest-first order 1, 5, 3, 2, 4 (not --sorted_result: the
--echo # --- order the plan produces is itself part of what is verified) ---
SELECT id FROM t ORDER BY L2_DISTANCE(v, '[1,2,3,4]') LIMIT 10;

--echo # --- LIMIT smaller than the row set: the 3 nearest -> 1, 5, 3 ---
SELECT id FROM t ORDER BY L2_DISTANCE(v, '[1,2,3,4]') LIMIT 3;

--echo # --- Filter above the scan: id > 2 leaves {3,4,5}; nearest-first 5, 3, 4.
--echo # --- (5 - 3, not a bare literal, keeps this a filter above the scan.) ---
SELECT id FROM t WHERE id > 5 - 3 ORDER BY L2_DISTANCE(v, '[1,2,3,4]') LIMIT 10;

DROP TABLE t;
UNINSTALL EXTENSION vsql_vector;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
