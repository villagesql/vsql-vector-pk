# Primary-key constraints for HNSW (USING EXTENDED) indexes.
#
# The colocated row-resolution path (HAS_COLUMN_REF) stores, alongside each
# vector, the leading field of the owning row's clustered key ("rowid_prefix")
# in a fixed-size region. That imposes two constraints on the table's primary
# key, both enforced up front at CREATE INDEX:
#
#   1. Single-column key. Only clustered field 0 is captured, so a composite
#      primary key would resolve ambiguously.
#
#   2. Key must fit the fixed rowid region. The key's declared max length must
#      not exceed the region, so a wider key is rejected at CREATE without
#      waiting for an oversized value at INSERT.
#
# This test exercises the observable behavior of both: which statement fails and
# that a fitting key still works end to end. It asserts the error code but not
# the exact byte bound nor the detail message wording, so it stays valid if the
# region size or wording changes. The extension's specific reason is surfaced to
# the client (not the error log), so no log suppressions are needed.

SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_vector;


--echo # ===================================================================
--echo # 1. Composite primary key is rejected at CREATE INDEX
--echo # ===================================================================

--echo # Inline composite PK + inline HNSW index: CREATE TABLE must fail.
# The gate fires inside the InnoDB create path. It surfaces via the generic
# engine "Got error N '<message>' from InnoDB" envelope (ER_GET_ERRMSG),
# carrying the extension's specific reason -- not the detail-less ER_GET_ERRNO.
--error ER_GET_ERRMSG
CREATE TABLE t_multi (
  a INT NOT NULL,
  b INT NOT NULL,
  v SVECTOR(4) NOT NULL,
  PRIMARY KEY (a, b),
  INDEX idx_v (v) USING EXTENDED(hnsw)
) ENGINE=InnoDB;

--echo # Same rejection via CREATE INDEX on an already-composite-PK table.
CREATE TABLE t_multi (
  a INT NOT NULL,
  b INT NOT NULL,
  v SVECTOR(4) NOT NULL,
  PRIMARY KEY (a, b)
) ENGINE=InnoDB;

--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx_v ON t_multi (v) USING EXTENDED(hnsw);

--echo # And via ALTER TABLE ADD INDEX.
--error ER_VILLAGESQL_GENERIC_ERROR
ALTER TABLE t_multi ADD INDEX idx_v (v) USING EXTENDED(hnsw);

--echo # The index was never created: the table has no HNSW index.
SHOW CREATE TABLE t_multi;
DROP TABLE t_multi;


--echo # ===================================================================
--echo # 2. Oversized single-column key is rejected at CREATE INDEX
--echo # ===================================================================
--echo # The key's declared max length must fit the fixed rowid region, so a key
--echo # wider than the region is rejected up front -- no need to wait for an
--echo # oversized value at INSERT.

--echo # Declared max (64 bytes) exceeds the rowid region: CREATE TABLE must fail.
--error ER_GET_ERRMSG
CREATE TABLE t_wide (
  k VARBINARY(64) NOT NULL PRIMARY KEY,
  v SVECTOR(4) NOT NULL,
  INDEX idx_v (v) USING EXTENDED(hnsw)
) ENGINE=InnoDB;

--echo # A key whose declared max fits the region is accepted, and rows insert.
CREATE TABLE t_fit (
  k VARBINARY(32) NOT NULL PRIMARY KEY,
  v SVECTOR(4) NOT NULL,
  INDEX idx_v (v) USING EXTENDED(hnsw)
) ENGINE=InnoDB;

INSERT INTO t_fit VALUES (REPEAT(_binary 'x', 8), '[1.0, 2.0, 3.0, 4.0]');
INSERT INTO t_fit VALUES (REPEAT(_binary 'y', 32), '[5.0, 6.0, 7.0, 8.0]');
# Count via the primary key: a bare scan would pick the custom index, which is
# not directly scannable.
SELECT COUNT(*) AS rows_after_insert FROM t_fit FORCE INDEX (PRIMARY);
DROP TABLE t_fit;


--echo # HNSW primary-key constraint test completed

UNINSTALL EXTENSION vsql_vector;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
