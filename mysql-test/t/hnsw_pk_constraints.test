# Primary-key constraints for HNSW (USING EXTENDED) indexes.
#
# The colocated row-resolution path (HAS_COLUMN_REF) stores, alongside each
# vector, the owning row's clustered key ("rowid_prefix") -- the server's packed
# primary key -- in a fixed-size region. A composite primary key is supported
# (the whole key is packed into the region); the only constraint, enforced up
# front at CREATE INDEX, is that the packed key must fit that region.
#
# This test exercises the observable behavior: a composite PK works end to end,
# and a key whose declared max is too large to pack is rejected at CREATE. It
# asserts the error code but not the exact byte bound nor the detail message
# wording, so it stays valid if the region size or wording changes. The
# extension's specific reason is surfaced to the client (not the error log), so
# no log suppressions are needed.

SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_vector;

--echo # ===================================================================
--echo # 1. Composite primary key is supported
--echo # ===================================================================

--echo # Inline composite PK + inline HNSW index.
CREATE TABLE t_multi (
  a INT NOT NULL,
  b INT NOT NULL,
  v SVECTOR(4) NOT NULL,
  PRIMARY KEY (a, b),
  INDEX idx_v (v) USING EXTENDED(hnsw)
) ENGINE=InnoDB;
SHOW CREATE TABLE t_multi;
DROP TABLE t_multi;

--echo # Also via CREATE INDEX / ALTER TABLE on an already-composite-PK table.
CREATE TABLE t_multi (
  a INT NOT NULL,
  b INT NOT NULL,
  v SVECTOR(4) NOT NULL,
  PRIMARY KEY (a, b)
) ENGINE=InnoDB;
CREATE INDEX idx_v ON t_multi (v) USING EXTENDED(hnsw);
DROP INDEX idx_v ON t_multi;
ALTER TABLE t_multi ADD INDEX idx_v (v) USING EXTENDED(hnsw);
SHOW CREATE TABLE t_multi;
DROP TABLE t_multi;

--echo # ===================================================================
--echo # 2. A primary key too large to pack is rejected at CREATE INDEX
--echo # ===================================================================
--echo # The packed key must fit the fixed rowid region, so a key whose declared
--echo # max is wider than the region is rejected up front -- no need to wait for
--echo # an oversized value at INSERT.

--echo # Declared max (1024 bytes) exceeds the rowid region: CREATE TABLE fails.
--error ER_GET_ERRMSG
CREATE TABLE t_wide (
  k VARBINARY(1024) NOT NULL PRIMARY KEY,
  v SVECTOR(4) NOT NULL,
  INDEX idx_v (v) USING EXTENDED(hnsw)
) ENGINE=InnoDB;

--echo # A key whose declared max fits the region is accepted, and rows insert.
CREATE TABLE t_fit (
  k VARBINARY(64) NOT NULL PRIMARY KEY,
  v SVECTOR(4) NOT NULL,
  INDEX idx_v (v) USING EXTENDED(hnsw)
) ENGINE=InnoDB;

INSERT INTO t_fit VALUES (REPEAT(_binary 'x', 8), '[1.0, 2.0, 3.0, 4.0]');
INSERT INTO t_fit VALUES (REPEAT(_binary 'y', 64), '[5.0, 6.0, 7.0, 8.0]');
# Count via the primary key: a bare scan would pick the custom index, which is
# not directly scannable.
SELECT COUNT(*) AS rows_after_insert FROM t_fit FORCE INDEX (PRIMARY);
DROP TABLE t_fit;

--echo # HNSW primary-key constraint test completed

UNINSTALL EXTENSION vsql_vector;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
