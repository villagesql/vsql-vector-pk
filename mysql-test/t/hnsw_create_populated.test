# CREATE INDEX ... USING EXTENDED(hnsw) on a table that already contains rows.
#
# The bulk-DDL builder scans the clustered index and inserts each existing row
# into the HNSW index, so the index is built over the pre-existing data. A KNN
# query afterwards returns those rows, proving they were indexed.
#
# Covers:
#   Empty table: standalone CREATE INDEX over no rows.
#   Populated table: CREATE INDEX builds the index over the existing rows, which
#     are then retrievable by a KNN query.
#   Incremental path: index declared at CREATE TABLE, rows loaded by INSERT.

SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_vector;

--echo # --- Empty table: standalone CREATE INDEX succeeds ---
CREATE TABLE t_empty (id INT PRIMARY KEY, v SVECTOR(4) NOT NULL);
CREATE INDEX idx ON t_empty (v) USING EXTENDED(hnsw);
SHOW CREATE TABLE t_empty;
DROP TABLE t_empty;

--echo # --- Populated table: CREATE INDEX builds the index over existing rows ---
CREATE TABLE t_full (id INT PRIMARY KEY, v SVECTOR(4) NOT NULL);
INSERT INTO t_full VALUES (1, '[1.0, 2.0, 3.0, 4.0]'), (2, '[5.0, 6.0, 7.0, 8.0]');
CREATE INDEX idx ON t_full (v) USING EXTENDED(hnsw);

--echo # --- The pre-existing rows are in the index: a KNN query returns them ---
SELECT id FROM t_full ORDER BY L2_DISTANCE(v, '[1.0, 2.0, 3.0, 4.0]') LIMIT 2;
DROP TABLE t_full;

--echo # --- Incremental path: index at CREATE TABLE, then load rows ---
CREATE TABLE t_ok (
  id INT PRIMARY KEY,
  v  SVECTOR(4) NOT NULL,
  INDEX idx (v hnsw_l2) USING EXTENDED(hnsw)
) ENGINE=InnoDB;
INSERT INTO t_ok VALUES (1, '[1.0, 2.0, 3.0, 4.0]'), (2, '[5.0, 6.0, 7.0, 8.0]');
SELECT id FROM t_ok ORDER BY L2_DISTANCE(v, '[1.0, 2.0, 3.0, 4.0]') LIMIT 1;
DROP TABLE t_ok;

--echo # HNSW create-index-on-populated-table test completed
UNINSTALL EXTENSION vsql_vector;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
